{
  "manifest_version": 2,
  "name": "Browser Download Streamer",
  "version": "1.0.1",
  "description": "Streams live download metrics from Firefox, Zen, and Gecko browsers to your local system.",
  "author": "Rizmi",
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-download-streamer@rizmi.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Browser Download Streamer",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg",
    "128": "icon-128.png"
  }
}
